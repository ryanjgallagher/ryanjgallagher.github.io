---
import Layout from '../../layouts/Layout.astro';
import { formatDate, getPosts } from '../../utils/blog';
import { publicationUri } from '../../utils/standard-site';
import '../../styles/blog.css';

const posts = await getPosts();
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Layout pageTitle="Blog">
    <Fragment slot="head">
        <!-- standard.site: the blog's record on your PDS, so apps like Bluesky can show a card for this page -->
        <link rel="site.standard.publication" href={publicationUri} />
    </Fragment>

    <div class="page-container">
        <h1>Blog</h1>

        {posts.length === 0 && <p class="intro-text">No posts yet.</p>}

        {allTags.length > 0 && (
            <div class="blog-tag-filters">
                <button class="blog-tag-btn active" data-tag="all">All</button>
                {allTags.map((tag) => <button class="blog-tag-btn" data-tag={tag}>{tag}</button>)}
            </div>
        )}

        <div class="blog-grid" id="blog-grid">
            {posts.map((post) => (
                <a href={`/blog/${post.id}/`} class="blog-card" data-tags={JSON.stringify(post.data.tags)}>
                    <div class="blog-card-inner">
                        <span class="blog-card-date">
                            {formatDate(post.data.publishedAt)}{post.data.draft && ' · DRAFT'}
                        </span>
                        <div>
                            <h2 class="blog-card-title">{post.data.title}</h2>
                            {post.data.description && <p class="blog-card-description">{post.data.description}</p>}
                            {post.data.tags.length > 0 && (
                                <div class="blog-card-tags">
                                    {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                                </div>
                            )}
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </div>
</Layout>

<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.blog-tag-btn');
    const cards = document.querySelectorAll<HTMLElement>('.blog-card');

    buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
            buttons.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            const selected = btn.dataset.tag!;
            cards.forEach((card) => {
                const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
                card.style.display = selected === 'all' || tags.includes(selected) ? '' : 'none';
            });
        });
    });
</script>
