---
import { Icon } from 'astro-icon/components';
import { SOCIALS } from '../constants';

interface Props {
  size?: number;
  gap?: string;
  class?: string;
}

const { size = 24, gap = '1.5rem', class: className } = Astro.props;

// On blog pages (the list and each post), an RSS icon for the blog's feed goes after the others
const onBlog = Astro.url.pathname.startsWith('/blog');
---

<div class:list={['social-icons', className]} style={{ gap }}>
  {SOCIALS.map((s) => (
    <a href={s.url} aria-label={s.label} title={s.label} rel="me">
      <Icon name={s.icon} size={size} />
    </a>
  ))}
  {onBlog && (
    <a href="/blog/rss.xml" aria-label="RSS feed" title="RSS feed">
      <Icon name="fa6-solid:rss" size={size} />
    </a>
  )}
</div>
